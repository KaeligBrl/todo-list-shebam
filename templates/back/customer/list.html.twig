{% extends 'back/admin.html.twig' %}

{% block title %}Liste des clients - {% block title_base %}{{ parent() }}{% endblock %}{% endblock %}
{% block admin_page_title %}Clients{% endblock %}

{% block admin_toolbar %}
    <div class="admin-toolbar">
        <input type="search" class="form-control js-admin-filter-input" placeholder="Filtrer les clients...">
    </div>
{% endblock %}

{% block content %}
			<form id="bulk-delete-customer-form" action="{{ path('delete_customer_batch') }}" method="post" class="mb-3 d-flex align-items-center" onsubmit="return confirm('Attention vous vous appretez a supprimer plusieurs clients')">
				<input type="hidden" name="_token" value="{{ csrf_token('delete_customer_batch') }}">
				<button type="submit" class="btn btn-danger btn-sm js-bulk-delete-customer-btn" disabled>Supprimer la selection</button>
				<span class="ml-2 text-muted small js-bulk-delete-customer-count">0 selection</span>
			</form>
			<table id="testaa" class="table table-bordered js-admin-table" data-toggle="table" data-pagination="true" data-search="true">
				<thead class="bg-blue-dark-light">
					<tr>
						<th class="color-yellow" scope="col" style="width:44px;">
							<input type="checkbox" class="js-customer-select-all" title="Tout selectionner" aria-label="Tout selectionner">
						</th>
						<th class="color-yellow" scope="col">Nom du client</th>
                        <th class="color-yellow" scope="col">Action</th>
					</tr>
				</thead>
				<tbody class="bg-blue-dark table-borderless">
					{% for customer in customers %}
						<tr>
							<td class="align-middle">
								<input type="checkbox" class="js-customer-select-item" name="customer_ids[]" value="{{ customer.id }}" form="bulk-delete-customer-form" aria-label="Selectionner le client {{ customer.id }}">
							</td>
							<td class="color-white text-bold">
								<span class="js-customer-name-text">{{ customer.name }}</span>
								<input type="text" class="form-control form-control-sm d-none js-customer-name-input" value="{{ customer.name }}" maxlength="255">
							</td>
							<td>
								<button type="button" class="admin-icon-btn border-0 p-0 js-customer-edit-toggle" style="background: transparent;" title="Modifier"><i class="fas fa-cog"></i></button>
								<button type="button" class="admin-icon-btn border-0 p-0 d-none js-customer-edit-save" style="background: transparent;" data-url="{{ path('modify_customer_back', {'id': customer.id}) }}" title="Enregistrer"><i class="fas fa-check"></i></button>
								<button type="button" class="admin-icon-btn border-0 p-0 d-none js-customer-edit-cancel" style="background: transparent;" title="Annuler"><i class="fas fa-times"></i></button>
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
			<p class="text-center text-bold admin-note-text mt-3">Si tu supprimes un client, penses à verifier avant si une tâche ne lui est pas attribuée.</p>

			<script>
				(function () {
					var inlineCsrfToken = '{{ csrf_token('modify_customer_back') }}';
					var selectAll = document.querySelector('.js-customer-select-all');
					var itemSelector = '.js-customer-select-item';
					var submitButton = document.querySelector('.js-bulk-delete-customer-btn');
					var counter = document.querySelector('.js-bulk-delete-customer-count');

					if (!submitButton || !counter) {
						return;
					}

					function getItems() {
						return Array.prototype.slice.call(document.querySelectorAll(itemSelector));
					}

					function updateState() {
						var items = getItems();
						var checkedCount = items.filter(function (item) {
							return item.checked;
						}).length;

						submitButton.disabled = checkedCount === 0;
						counter.textContent = checkedCount + (checkedCount > 1 ? ' selections' : ' selection');

						if (selectAll) {
							selectAll.checked = items.length > 0 && checkedCount === items.length;
							selectAll.indeterminate = checkedCount > 0 && checkedCount < items.length;
						}
					}

					if (selectAll) {
						selectAll.addEventListener('change', function () {
							var items = getItems();
							items.forEach(function (item) {
								item.checked = selectAll.checked;
							});
							updateState();
						});
					}

					document.addEventListener('change', function (event) {
						if (event.target && event.target.matches(itemSelector)) {
							updateState();
						}
					});

					function setInlineMode(row, isEditing) {
						if (!row) {
							return;
						}

						var text = row.querySelector('.js-customer-name-text');
						var input = row.querySelector('.js-customer-name-input');
						var editButton = row.querySelector('.js-customer-edit-toggle');
						var saveButton = row.querySelector('.js-customer-edit-save');
						var cancelButton = row.querySelector('.js-customer-edit-cancel');

						if (!text || !input || !editButton || !saveButton || !cancelButton) {
							return;
						}

						text.classList.toggle('d-none', isEditing);
						input.classList.toggle('d-none', !isEditing);
						editButton.classList.toggle('d-none', isEditing);
						saveButton.classList.toggle('d-none', !isEditing);
						cancelButton.classList.toggle('d-none', !isEditing);

						if (isEditing) {
							input.value = text.textContent.trim();
							input.focus();
							input.select();
						}
					}

					function saveInline(row) {
						var text = row.querySelector('.js-customer-name-text');
						var input = row.querySelector('.js-customer-name-input');
						var saveButton = row.querySelector('.js-customer-edit-save');
						if (!text || !input || !saveButton) {
							return;
						}

						var nextName = input.value.trim();
						if (!nextName) {
							window.alert('Le nom du client est obligatoire.');
							input.focus();
							return;
						}

						saveButton.setAttribute('disabled', 'disabled');

						var formData = new FormData();
						formData.append('name', nextName);
						formData.append('_token', inlineCsrfToken);

						fetch(saveButton.getAttribute('data-url'), {
							method: 'POST',
							body: formData,
							headers: {
								'X-Requested-With': 'XMLHttpRequest'
							},
							credentials: 'same-origin'
						})
							.then(function (response) {
								return response.json().then(function (payload) {
									return {
										ok: response.ok,
										payload: payload
									};
								});
							})
							.then(function (result) {
								if (!result.ok || !result.payload || result.payload.success !== true) {
									var message = (result.payload && result.payload.message) ? result.payload.message : 'Impossible de modifier le client.';
									throw new Error(message);
								}

								text.textContent = result.payload.customer && result.payload.customer.name ? result.payload.customer.name : nextName;
								setInlineMode(row, false);
							})
							.catch(function (error) {
								window.alert(error.message || 'Impossible de modifier le client.');
							})
							.finally(function () {
								saveButton.removeAttribute('disabled');
							});
					}

					document.addEventListener('click', function (event) {
						var editButton = event.target.closest('.js-customer-edit-toggle');
						if (editButton) {
							event.preventDefault();
							setInlineMode(editButton.closest('tr'), true);
							return;
						}

						var cancelButton = event.target.closest('.js-customer-edit-cancel');
						if (cancelButton) {
							event.preventDefault();
							setInlineMode(cancelButton.closest('tr'), false);
							return;
						}

						var saveButton = event.target.closest('.js-customer-edit-save');
						if (saveButton) {
							event.preventDefault();
							saveInline(saveButton.closest('tr'));
						}
					});

					document.addEventListener('keydown', function (event) {
						if (!event.target || !event.target.matches('.js-customer-name-input')) {
							return;
						}

						if (event.key === 'Enter') {
							event.preventDefault();
							saveInline(event.target.closest('tr'));
						}

						if (event.key === 'Escape') {
							event.preventDefault();
							setInlineMode(event.target.closest('tr'), false);
						}
					});

					updateState();
				})();
			</script>
{% endblock %}


