{% extends 'back/admin.html.twig' %}

{% block title %}Modifier le rôle - {% block title_base %}{{ parent() }}{% endblock %}{% endblock %}

{% block body %}
    {% block content %}
        <div class="d-flex justify-content-center color-white">
            <h1>Modifier le rôle : {{ roleName }}</h1>
        </div>

        {{ form_start(form) }}
        <div class="form-back" style="max-width: 1050px !important">

        {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
        {% endfor %}
        
        {% for message in app.flashes('warning') %}
        <div class="alert alert-warning">{{ message }}</div>
        {% endfor %}
            {{ form_row(form.role) }}
            {{ form_row(form.label) }}
            <div class="inputRole">
                <p class="form-role-title text-center mb-4">Semaine Actuelle</p>
                <div class="row mb-4">
                    <div class="col">
                        <p class="form-role-title text-center">Tâche P1</p>
                            {{ form_row(form.add_task_cw) }}
                            {{ form_row(form.p2_button_in_p1_cw) }} 
                            {{ form_row(form.task_p1_cw_to_p1_nw_button) }}
                            {{ form_row(form.task_p1_modify_button) }} 
                            {{ form_row(form.task_p1_delete_button) }}                    </div>
                    <div class="col">
                        <p class="form-role-title text-center">Tâche P2</p>
                            {{ form_row(form.p1_button_in_p2_cw) }}
                            {{ form_row(form.task_p2_cw_to_p1_nw_button) }}
                            {{ form_row(form.task_p2_modify_button) }}
                            {{ form_row(form.task_p2_delete_button) }}                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <p class="form-role-title text-center mb-4 mt-4">Rendez-vous</p>
                            {{ form_row(form.appointment_cw_to_nw) }}
                            {{ form_row(form.appointment_modify_cw) }}
                            {{ form_row(form.appointment_delete_cw) }}
                    </div>
                </div>
                <p class="form-role-title text-center mb-4 mt-4">Semaine Suivante</p>
                <div class="row">
                    <div class="col">
                        <p class="form-role-title text-center">Tâche P1</p>
                            {{ form_row(form.task_p1_to_p2_nw)}}
                            {{ form_row(form.task_p1_nw_to_p1_cw_button) }}
                            {{ form_row(form.task_p1_modify_nw) }}
                            {{ form_row(form.task_p1_delete_nw) }}
                    </div>
                    <div class="col">
                        <p class="form-role-title text-center">Tâche P2</p>
                            {{ form_row(form.task_p2_to_p1_nw)}}
                            {{ form_row(form.task_p2_nw_to_p2_cw_button) }}
                            {{ form_row(form.task_p2_modify_nw) }}
                            {{ form_row(form.task_p2_delete_nw) }}
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <p class="form-role-title text-center mb-4 mt-4">Rendez-vous</p>
                            {{ form_row(form.appointment_nw_to_cw) }}
                            {{ form_row(form.appointment_modify_nw) }}
                            {{ form_row(form.appointment_delete_nw) }}
                    </div>
                </div>
                
                <p class="form-role-title text-center mb-4 mt-4">Global</p>
                <div class="row">
                    <div class="col">
                        <p class="form-role-title">Fonctionnalités</p>
                            {{ form_row(form.show_switch_to_cw) }}
                            {{ form_row(form.add_task) }}
                    </div>
                    <div class="col">
                            {{ form_row(form.reorder_task) }}
                            {{ form_row(form.generate_archive_task) }}

                    </div>
                </div>
                <p class="form-role-title text-center mb-4 mt-4">Idébam</p>
                <div class="row">
                    <div class="col">
                        {{ form_row(form.add_ideabam) }}
                        {{ form_row(form.modify_ideabam) }}
                        {{ form_row(form.delete_ideabam) }}
                    </div>
                    <div class="col">
                    </div>
                </div>

            </div>
                <p class="form-role-title text-center mb-4 mt-4">Accès aux URLS</p>
                {% set last_category = null %}
                {% set routes_by_category = {} %}
                {# Regrouper les routes par controller #}
                {% for route in routes %}
                    {% set cat = attribute(route, 'controller') %}
                    {% if routes_by_category[cat] is not defined %}
                        {% set routes_by_category = routes_by_category|merge({ (cat): [route] }) %}
                    {% else %}
                        {% set routes_by_category = routes_by_category|merge({ (cat): routes_by_category[cat]|merge([route]) }) %}
                    {% endif %}
                {% endfor %}

                {% for cat, cat_routes in routes_by_category %}
                    {% set cols = 2 %}
                    {% set col_class = 'col-6' %}
                    <div class="row">
                        {% for route in cat_routes %}
                            <div class="{{ col_class }}">
                                <label class="color-yellow text-bold">
                                    {{ form_row(form[route.name]) }}
                                </label>
                            </div>
                            {% if loop.index is divisible by(cols) and not loop.last %}
                                </div><div class="row">
                            {% endif %}
                        {% endfor %}
                    </div>
                {% endfor %}
            <div class="d-flex justify-content-center mt-3">{{ form_row(form.submit) }}</div>

        </div>
        {{ form_end(form) }}
    {% endblock %}
{% endblock %}
