{% extends 'back/admin.html.twig' %}

{% block title %}Liste des téléchargements - {% block title_base %}{{ parent() }}{% endblock %}{% endblock %}
{% block admin_page_title %}Téléchargements{% endblock %}

{% block admin_toolbar %}
    <div class="admin-toolbar">
        <input type="search" class="form-control js-admin-filter-input" placeholder="Filtrer l'historique...">
        <span class="text-muted small">Journal des exports PDFs</span>
    </div>
{% endblock %}

{% block content %}
			<table class="table js-admin-table" data-toggle="table">
				<thead class="bg-blue-dark-light">
					<tr>
                        <th class="color-yellow" scope="col">Type</th>
						<th class="color-yellow" scope="col">Date de generation</th>
						<th class="color-yellow" scope="col">Taille</th>
						<th class="color-yellow" scope="col">Statut</th>
						<th class="color-yellow" scope="col">Action</th>
					</tr>
				</thead>
				<tbody class="bg-blue-dark table-borderless">
					{% for row in files_view %}
						{% set file = row.entity %}
						<tr>
							<td  class="color-white text-bold">{{ row.label }}</td>
							<td  class="color-white text-bold">{{ file.createdat|date("d-m-Y", "Europe/Paris")}} à {{file.createdat|date("H:i", "Europe/Paris")}}</td>
							<td class="color-white text-bold">
								{% if row.size is not null %}
									{{ (row.size / 1024)|number_format(1, ',', ' ') }} Ko
								{% else %}
									-
								{% endif %}
							</td>
							<td class="color-white text-bold">
								{% if row.status == 'done' %}
									<span class="badge badge-success">Disponible</span>
								{% elseif row.status == 'failed' %}
									<span class="badge badge-danger" title="{{ row.error|default('Erreur inconnue')|e('html_attr') }}">Echec</span>
								{% else %}
									<span class="badge badge-secondary">Archive</span>
								{% endif %}
							</td>
                            <td>
								<a class="admin-icon-btn" href="{{ path('view_download', {'id': file.id}) }}" target="_blank" rel="noopener" title="Consulter"><i class="fas fa-eye"></i></a>
								<form action="{{ path('delete_download', {'id': file.id}) }}" method="post" class="d-inline" onsubmit="return confirm('Attention vous vous appretez a supprimer un telechargement')">
									<input type="hidden" name="_token" value="{{ csrf_token('delete_download_' ~ file.id) }}">
									<button type="submit" class="admin-icon-btn border-0 p-0" style="background: transparent;" title="Supprimer"><i class="fas fa-trash"></i></button>
								</form>
                            </td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
{% endblock %}

