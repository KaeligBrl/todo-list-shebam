{% extends 'back/admin.html.twig' %}

{% block title %}Liste des téléchargements - {% block title_base %}{{ parent() }}{% endblock %}{% endblock %}
{% block admin_page_title %}Téléchargements{% endblock %}

{% block admin_toolbar %}
    <div class="admin-toolbar">
        <input type="search" class="form-control js-admin-filter-input" placeholder="Filtrer l'historique...">
        <span class="text-muted small">Journal des exports PDFs</span>
    </div>
{% endblock %}

{% block content %}
			<form id="bulk-delete-download-form" action="{{ path('delete_download_batch') }}" method="post" class="mb-3 d-flex align-items-center" onsubmit="return confirm('Attention vous vous appretez a supprimer plusieurs telechargements')">
				<input type="hidden" name="_token" value="{{ csrf_token('delete_download_batch') }}">
				<button type="submit" class="btn btn-danger btn-sm js-bulk-delete-btn" disabled>Supprimer la selection</button>
				<span class="ml-2 text-muted small js-bulk-delete-count">0 selection</span>
			</form>
			<table class="table js-admin-table" data-toggle="table">
				<thead class="bg-blue-dark-light">
					<tr>
						<th class="color-yellow" scope="col" style="width:44px;">
							<input type="checkbox" class="js-download-select-all" title="Tout selectionner" aria-label="Tout selectionner">
						</th>
                        <th class="color-yellow" scope="col">Type</th>
						<th class="color-yellow" scope="col">Date de generation</th>
						<th class="color-yellow" scope="col">Taille</th>
						<th class="color-yellow" scope="col">Statut</th>
						<th class="color-yellow" scope="col">Action</th>
					</tr>
				</thead>
				<tbody class="bg-blue-dark table-borderless">
					{% for row in files_view %}
						{% set file = row.entity %}
						<tr>
							<td class="align-middle">
								<input type="checkbox" class="js-download-select-item" name="download_ids[]" value="{{ file.id }}" form="bulk-delete-download-form" aria-label="Selectionner l'export {{ file.id }}">
							</td>
							<td  class="color-white text-bold">{{ row.label }}</td>
							<td  class="color-white text-bold">{{ file.createdat|date("d-m-Y", "Europe/Paris")}} à {{file.createdat|date("H:i", "Europe/Paris")}}</td>
							<td class="color-white text-bold">
								{% if row.size is not null %}
									{{ (row.size / 1024)|number_format(1, ',', ' ') }} Ko
								{% else %}
									-
								{% endif %}
							</td>
							<td class="color-white text-bold">
								{% if row.status == 'done' %}
									<span class="badge badge-success">Disponible</span>
								{% elseif row.status == 'failed' %}
									<span class="badge badge-danger" title="{{ row.error|default('Erreur inconnue')|e('html_attr') }}">Echec</span>
								{% else %}
									<span class="badge badge-secondary">Archive</span>
								{% endif %}
							</td>
                            <td>
								<a class="admin-icon-btn" href="{{ path('view_download', {'id': file.id}) }}" target="_blank" rel="noopener" title="Consulter"><i class="fas fa-eye"></i></a>
								<form action="{{ path('delete_download', {'id': file.id}) }}" method="post" class="d-inline" onsubmit="return confirm('Attention vous vous appretez a supprimer un telechargement')">
									<input type="hidden" name="_token" value="{{ csrf_token('delete_download_' ~ file.id) }}">
									<button type="submit" class="admin-icon-btn border-0 p-0" style="background: transparent;" title="Supprimer"><i class="fas fa-trash"></i></button>
								</form>
                            </td>
						</tr>
					{% endfor %}
				</tbody>
			</table>

			<script>
				(function () {
					var selectAll = document.querySelector('.js-download-select-all');
					var itemSelector = '.js-download-select-item';
					var submitButton = document.querySelector('.js-bulk-delete-btn');
					var counter = document.querySelector('.js-bulk-delete-count');

					if (!submitButton || !counter) {
						return;
					}

					function getItems() {
						return Array.prototype.slice.call(document.querySelectorAll(itemSelector));
					}

					function updateState() {
						var items = getItems();
						var checkedCount = items.filter(function (item) {
							return item.checked;
						}).length;

						submitButton.disabled = checkedCount === 0;
						counter.textContent = checkedCount + (checkedCount > 1 ? ' selections' : ' selection');

						if (selectAll) {
							selectAll.checked = items.length > 0 && checkedCount === items.length;
							selectAll.indeterminate = checkedCount > 0 && checkedCount < items.length;
						}
					}

					if (selectAll) {
						selectAll.addEventListener('change', function () {
							var items = getItems();
							items.forEach(function (item) {
								item.checked = selectAll.checked;
							});
							updateState();
						});
					}

					document.addEventListener('change', function (event) {
						if (event.target && event.target.matches(itemSelector)) {
							updateState();
						}
					});

					updateState();
				})();
			</script>
{% endblock %}

