{% extends 'back/admin.html.twig' %}

{% block title %}Liste de l'équipe - {% block title_base %}{{ parent() }}{% endblock %}{% endblock %}
{% block admin_page_title %}Equipe{% endblock %}

{% block admin_toolbar %}
    <div class="admin-toolbar">
        <input type="search" class="form-control js-admin-filter-input" placeholder="Filtrer l'equipe...">
        {% if is_granted('IS_AUTHENTICATED_FULLY') and is_granted('ROLE_ADMIN') %}
            <a class="btn btn-warning btn-sm text-bold" href="{{ path('user_add') }}"><i class="fas fa-plus-circle"></i>&nbsp;Ajouter un utilisateur</a>
        {% endif %}
    </div>
{% endblock %}

{% block content %}
			<table class="table js-admin-table" data-pagination="true" data-toggle="table" data-search="true">
				<thead class="bg-blue-dark-light">
					<tr>
						<th class="color-yellow" scope="col">Photo</th>
						<th class="color-yellow" scope="col">Nom</th>
						<th class="color-yellow" scope="col">Prénom</th>
						<th class="color-yellow" scope="col">Adresse Mail</th>
						<th class="color-yellow" scope="col">Rôle</th>
						<th class="color-yellow" scope="col">Action</th>
					</tr>
				</thead>
				<tbody class="bg-blue-dark table-borderless">
					{% for user in user %}
						<tr>
							<td class="color-white text-bold">
								{% if user.profilePicture %}
									<img src="{{ asset(user.profilePicture) }}" alt="Photo {{ user.firstname }}" style="width:44px;height:44px;border-radius:50%;object-fit:cover;border:2px solid #ffd54f;">
								{% else %}
									<span style="display:inline-flex;width:44px;height:44px;border-radius:50%;align-items:center;justify-content:center;background:#27374d;color:#fff;font-weight:700;">{{ user.firstname|slice(0,1)|upper }}</span>
								{% endif %}
							</td>
							<td class="color-white text-bold">{{user.lastname}}</td>
							<td class="color-white text-bold">{{user.firstname}}</td>
							<td class="color-white text-bold">{{user.email}}</td>
							<td class="color-white text-bold">                        
								{# On boucle sur les rôles #}
								{% for role in user.roles %}
									{% if role == "ROLE_UTILISATEUR" %}
										Utilisateur
									{% elseif role == "ROLE_STAGIAIRE" %}
										Stagiaire
									{% elseif role == "ROLE_ADMIN" %}
										Administrateur
									{% endif %}
								{% endfor %}
							</td>
							<td>
								<a class="admin-icon-btn" href="{{ path('user_modify', {"id": user.id}) }}" title="Modifier"><i class="fas fa-cog"></i></a>
								<a class="admin-icon-btn" href="{{ path('user_delete', {"id": user.id}) }}" title="Supprimer" onclick="return confirm('Attention vous vous apprettez à supprimer un utilisateur')"><i class="fas fa-trash"></i></a>
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
{% endblock %}

