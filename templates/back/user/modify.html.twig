{% extends 'back/admin.html.twig' %}

{% block title %}Modifier utilisateur - {% block title_base %}{{ parent() }}{% endblock %}{% endblock %}
{% block admin_page_title %}Modifier l'utilisateur{% endblock %}

{% block admin_toolbar %}
	<div class="admin-toolbar">
		<a class="btn btn-outline-secondary btn-sm" href="{{ path('user_list') }}">Retour à l'equipe</a>
		<span class="text-muted small">Edition du profil de {{ user.firstname }} {{ user.lastname }}</span>
	</div>
{% endblock %}

{% block content %}
	{% if notification %}
		<div class="alert alert-success mb-3" role="alert">
			{{ notification }}
		</div>
	{% endif %}

	{{ form_start(form_user_modify_admin, {'attr': {'class': 'mb-0'}}) }}
		<div class="row">
			<div class="col-lg-4 mb-3 mb-lg-0">
				<div class="p-3 h-100" style="border:1px solid rgba(255,255,255,.08);border-radius:12px;background:rgba(255,255,255,.02);">
					<div class="text-center mb-3">
						{% if user.profilePicture %}
							<img src="{{ asset(user.profilePicture) }}" alt="Photo de profil" style="width:96px;height:96px;border-radius:50%;object-fit:cover;border:2px solid #ffd54f;">
						{% else %}
							<span style="display:inline-flex;width:96px;height:96px;border-radius:50%;align-items:center;justify-content:center;background:#27374d;color:#fff;font-size:30px;font-weight:700;border:2px solid #ffd54f;">{{ user.firstname|slice(0,1)|upper }}</span>
						{% endif %}
					</div>
					<div class="text-center color-white text-bold">{{ user.firstname }} {{ user.lastname }}</div>
					<div class="text-center text-muted small mb-3">{{ user.email }}</div>
					<div class="text-muted small">Tu peux modifier le nom, le prenom, le role et la photo depuis ce formulaire.</div>
				</div>
			</div>

			<div class="col-lg-8">
				<div class="p-3" style="border:1px solid rgba(255,255,255,.08);border-radius:12px;background:rgba(255,255,255,.02);">
					<div class="form-group mb-3">
						<label class="color-yellow text-bold mb-2">Adresse mail</label>
						{{ form_widget(form_user_modify_admin.email) }}
					</div>

					<div class="form-row">
						<div class="form-group col-md-6">
							<label class="color-yellow text-bold mb-2">Prenom</label>
							{{ form_widget(form_user_modify_admin.firstname) }}
						</div>
						<div class="form-group col-md-6">
							<label class="color-yellow text-bold mb-2">Nom</label>
							{{ form_widget(form_user_modify_admin.lastname) }}
						</div>
					</div>

					<div class="form-group mb-3">
						<label class="color-yellow text-bold mb-2">Role</label>
						{{ form_widget(form_user_modify_admin.roles) }}
					</div>

					<div class="form-group mb-4">
						<label class="color-yellow text-bold mb-2">Photo de profil</label>
						<div class="admin-upload-field p-3" style="border:1px dashed rgba(255,255,255,.28);border-radius:10px;background:rgba(255,255,255,.02);">
							<input
								type="file"
								id="{{ form_user_modify_admin.profilePictureFile.vars.id }}"
								name="{{ form_user_modify_admin.profilePictureFile.vars.full_name }}"
								class="js-profile-file-input"
								hidden
								style="display:none;"
								accept="image/*"
							>

							<div class="d-flex align-items-center flex-wrap">
								<label for="{{ form_user_modify_admin.profilePictureFile.vars.id }}" class="btn btn-warning btn-sm mb-0 mr-2 text-bold" style="cursor:pointer;">
									<i class="fas fa-upload"></i>&nbsp;Choisir une image
								</label>
								<span class="small text-muted js-profile-file-name">Aucun fichier selectionne</span>
							</div>
							{{ form_errors(form_user_modify_admin.profilePictureFile) }}
							{% do form_user_modify_admin.profilePictureFile.setRendered %}
							<div class="small text-muted mt-2">Formats acceptes: JPG, PNG, WEBP (max 5 Mo).</div>
						</div>
					</div>

					<div class="d-flex align-items-center">
						{{ form_widget(form_user_modify_admin.submit) }}
						<a href="{{ path('user_list') }}" class="btn btn-link text-muted ml-2">Annuler</a>
					</div>
				</div>
			</div>
		</div>
	{{ form_end(form_user_modify_admin) }}

	<script>
		(function () {
			var input = document.querySelector('.js-profile-file-input');
			var fileName = document.querySelector('.js-profile-file-name');

			if (!input || !fileName) {
				return;
			}

			input.addEventListener('change', function () {
				if (input.files && input.files.length > 0) {
					fileName.textContent = input.files[0].name;
					fileName.classList.remove('text-muted');
					fileName.classList.add('color-white');
				} else {
					fileName.textContent = 'Aucun fichier selectionne';
					fileName.classList.add('text-muted');
					fileName.classList.remove('color-white');
				}
			});
		})();
	</script>
{% endblock %}