<!doctype html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>{%  block title %}{% block title_base %}Liste des tâches{% endblock %}{% endblock %}</title>
    <link rel="icon" href="{{ asset('assets/images/logo-to-do-list-vert.ico') }}" />
    {% block stylesheets %}

        <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css" integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
        <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.13.0/css/all.min.css" rel="stylesheet" crossorigin="anonymous">
        <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.7.1/css/all.css" integrity="sha384-fnmOCqbTlWIlj8LyTjo7mOUStjsKC4pOpQbqyi7RrhN7udi9RwhKkMHpvLbHG9Sr" crossorigin="anonymous">
        <link href="https://unpkg.com/bootstrap-table@1.18.3/dist/extensions/reorder-rows/bootstrap-table-reorder-rows.css" rel="stylesheet">
        <link rel="stylesheet" href="https://unpkg.com/bootstrap-table@1.16.0/dist/bootstrap-table.min.css">
        <link href="{{ asset('assets/css/bootstrap.min.css') }}" rel="stylesheet">
        <link href="{{ asset('assets/css/root.css') }}" rel="stylesheet">
        <link href="{{ asset('assets/css/front/custom.css') }}" rel="stylesheet">
        <link href="{{ asset('assets/css/motdepasse.css') }}" rel="stylesheet">
        <link href="{{ asset('assets/css/back/responsive.css') }}" rel="stylesheet">
        <link href="{{ asset('assets/css/back/admin-template.css') }}" rel="stylesheet">
    {% endblock %}
</head>
<body class="admin-layout-body">
    {% set routeName = app.request.attributes.get('_route')|default('') %}
    {% set breadcrumbSection = 'Administration' %}
    {% set breadcrumbPage = 'Tableau de bord' %}

    {% if routeName starts with 'list_customer' or routeName starts with 'add_customer_back' or routeName starts with 'modify_customer_back' %}
        {% set breadcrumbSection = 'Clients' %}
        {% if routeName starts with 'add_customer_back' %}
            {% set breadcrumbPage = 'Ajouter' %}
        {% elseif routeName starts with 'modify_customer_back' %}
            {% set breadcrumbPage = 'Modifier' %}
        {% else %}
            {% set breadcrumbPage = 'Liste' %}
        {% endif %}
    {% elseif routeName starts with 'user_' %}
        {% set breadcrumbSection = 'Equipe' %}
        {% if routeName starts with 'user_add' %}
            {% set breadcrumbPage = 'Ajouter' %}
        {% elseif routeName starts with 'user_modify' %}
            {% set breadcrumbPage = 'Modifier' %}
        {% else %}
            {% set breadcrumbPage = 'Liste' %}
        {% endif %}
    {% elseif routeName starts with 'role_' %}
        {% set breadcrumbSection = 'Roles' %}
        {% if routeName starts with 'role_add' %}
            {% set breadcrumbPage = 'Ajouter' %}
        {% elseif routeName starts with 'role_edit' %}
            {% set breadcrumbPage = 'Modifier' %}
        {% else %}
            {% set breadcrumbPage = 'Liste' %}
        {% endif %}
    {% elseif routeName starts with 'download_' %}
        {% set breadcrumbSection = 'Telechargements' %}
        {% set breadcrumbPage = 'Historique' %}
    {% endif %}

    <div class="admin-layout">
        <aside id="adminSidebar" class="admin-sidebar">
            <div class="admin-sidebar-head">
                <a class="d-flex align-items-center" href="{{ path('admin_dashboard') }}">
                    <img class="d-block" style="width: 126px" src="{{ asset('/assets/images/logo-todo.png') }}" alt="Logo To Do List">
                </a>
                <button type="button" class="btn btn-link d-lg-none p-0 admin-sidebar-close" id="adminSidebarClose" aria-label="Fermer le menu">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            {% if app.user %}
                {% set profilePicturePath = app.user.profilePicture|default('') %}
                {% set profilePictureUrl = profilePicturePath ? asset(profilePicturePath) : null %}
                <div class="admin-user-mini-profile">
                    <div class="admin-user-avatar-wrap">
                        {% if profilePictureUrl %}
                            <img class="admin-user-avatar" src="{{ profilePictureUrl }}" alt="Avatar {{ app.user.firstname|default('') }} {{ app.user.lastname|default('') }}">
                        {% else %}
                            <span class="admin-user-avatar admin-user-avatar-fallback">{{ (app.user.firstname|default('')|slice(0,1) ~ app.user.lastname|default('')|slice(0,1))|upper ?: '?' }}</span>
                        {% endif %}
                        <span class="admin-user-status-dot" title="Connecte"></span>
                    </div>
                    <div class="admin-user-text">
                        <div class="admin-user-name">{{ app.user.firstname|default('') }} {{ app.user.lastname|default('') }}</div>
                        <div class="admin-user-email">{{ app.user.email|default('') }}</div>
                        <div class="admin-user-role">{{ app.user.roles|first|replace({'ROLE_': ''}) }}</div>
                    </div>
                </div>
            {% endif %}

            <div class="admin-sidebar-label">Navigation</div>
            <nav class="admin-sidebar-nav">
                <a class="admin-side-link {% if app.request.attributes.get('_route') starts with 'admin_' %}active{% endif %}" href="{{ path('admin_dashboard') }}">
                    <i class="fas fa-th-large"></i><span>Tableau de bord</span>
                </a>
                <a class="admin-side-link {% if app.request.attributes.get('_route') starts with 'list_customer' or app.request.attributes.get('_route') starts with 'add_customer_back' or app.request.attributes.get('_route') starts with 'modify_customer_back' %}active{% endif %}" href="{{ path('list_customer') }}">
                    <i class="fas fa-building"></i><span>Clients</span>
                </a>
                <a class="admin-side-link {% if app.request.attributes.get('_route') starts with 'user_' %}active{% endif %}" href="{{ path('user_list') }}">
                    <i class="fas fa-users"></i><span>Equipe</span>
                </a>
                <a class="admin-side-link {% if app.request.attributes.get('_route') starts with 'role_' %}active{% endif %}" href="{{ path('role_list') }}">
                    <i class="fas fa-user-shield"></i><span>Roles</span>
                </a>
                <a class="admin-side-link {% if app.request.attributes.get('_route') starts with 'download_' %}active{% endif %}" href="{{ path('download_list') }}">
                    <i class="fas fa-file-download"></i><span>Telechargements</span>
                </a>
            </nav>

            <div class="admin-sidebar-footer">
                <a class="admin-side-ghost" href="{{ path('current_week_p1') }}">Retour Front</a>
                <a class="admin-side-ghost" href="{{ path('app_logout') }}"><i class="fas fa-unlock"></i>&nbsp;Deconnexion</a>
            </div>
        </aside>

        <div id="adminSidebarOverlay" class="admin-sidebar-overlay"></div>

        <main role="main" class="admin-main">
            <header class="admin-main-topbar">
                <button type="button" class="btn btn-link admin-sidebar-toggle" id="adminSidebarToggle" aria-label="Ouvrir le menu">
                    <i class="fas fa-bars"></i>
                </button>
                <div class="admin-main-context">Espace administration</div>
                <button type="button" class="btn btn-link admin-theme-toggle" id="adminThemeToggle" aria-label="Activer le theme clair" title="Changer le theme">
                    <i class="fas fa-moon"></i>
                    <span>Theme</span>
                </button>
                <nav class="admin-breadcrumb" aria-label="breadcrumb">
                    <ol>
                        <li><a href="{{ path('admin_dashboard') }}">Admin</a></li>
                        <li><span>{{ breadcrumbSection }}</span></li>
                        <li><strong>{{ breadcrumbPage }}</strong></li>
                    </ol>
                </nav>
            </header>

            <div class="container-fluid admin-shell py-4">
                <section class="admin-page-header mb-3">
                    <h1 class="admin-page-title mb-0">{% block admin_page_title %}Administration{% endblock %}</h1>
                    {% if app.user %}
                        <div class="admin-page-subtitle">Gestion interne de la plateforme</div>
                    {% endif %}
                </section>

                {% block admin_toolbar %}{% endblock %}

                {% for type, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ type == 'danger' ? 'danger' : (type == 'warning' ? 'warning' : 'success') }} mt-3 mb-0" role="alert">
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endfor %}

                <section class="admin-content-card">
                    {% block content %}{% endblock %}
                </section>
            </div>
        </main>
    </div>

{% block javascripts %}
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/TableDnD/1.0.3/jquery.tablednd.min.js"></script>
    <script src="{{ asset('assets/js/bootstrap.bundle.js') }}"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js" integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo" crossorigin="anonymous"></script>
    <script src="https://unpkg.com/bootstrap-table@1.16.0/dist/bootstrap-table.min.js"></script>
    <script src="https://unpkg.com/bootstrap-table@1.16.0/dist/locale/bootstrap-table-fr-FR.min.js"></script>
    <script src="https://unpkg.com/bootstrap-table@1.18.3/dist/extensions/reorder-rows/bootstrap-table-reorder-rows.min.js"></script>
    <script src="{{ asset('assets/js/motdepasse.js') }}?v=20260527"></script>
    <script src="{{ asset('assets/js/custom.js') }}"></script>
    <script src="{{ asset('assets/js/back-admin-ui.js') }}?v=20260528a"></script>

{% endblock %}

</body>
</html>