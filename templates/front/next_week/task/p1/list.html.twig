{% extends 'base.html.twig' %}

{% block content %}
    <title>{%  block title %}Semaine Suivante - {% block title_base %}{{ parent() }}{% endblock %}{% endblock %}</title>
	<div class="mb-5">
        <img class="d-block mx-auto" style="width: 300px" src="{{ asset('/assets/images/logo-todo.png') }}"
            alt="Logo de connexion To Do List">
		<h1 class="text-center color-white mb-3">Semaine Suivante</h1>
        <nav class="navbar navbar-expand-lg">
            <ul class="navbar-nav mx-auto " id="navbarqaqa">
                        <li class="nav-item"> 
                            <a class="
                                        {% if app.request.attributes.get('_route') starts with 'next_week_p1' %}active-filters{% endif %}
                                        navbar-text text-uppercase text-margin" href="{{ path('next_week_p1') }}">Priorité 1 <i class="color-white fas fa-tasks"></i></a>
                        </li>
                        <li class="nav-item"> 
                            <a class="navbar-text text-uppercase text-margin" href="{{ path('next_week_p2') }}">Priorité 2 <i class="color-white fas fa-tasks"></i></a>
                        </li>
                        <li class="nav-item"> 
                            <a class="navbar-text text-uppercase text-margin" href="{{ path('next_week_appointment') }}">Rendez-vous <i class="color-white far fa-calendar-check"></i></a></a>
                        </li>
            </ul> 
        </nav>
		<div class="container text-center padding-dopdown-mobile">
            {% set showActions = false %}
            {% if userRole is not null and roles[userRole] is defined %}
                {% set showActions =
                    roles[userRole].task_p1_to_p2_nw is defined and roles[userRole].task_p1_to_p2_nw or
                    roles[userRole].task_p1_nw_to_p1_cw_button is defined and roles[userRole].task_p1_nw_to_p1_cw_button or
                    roles[userRole].task_p1_modify_nw is defined and roles[userRole].task_p1_modify_nw or
                    roles[userRole].task_p1_delete_nw is defined and roles[userRole].task_p1_delete_nw
                %}
            {% endif %}
            {% set inlineAddCols = 6 + (showActions ? 1 : 0) %}

            {% if roles[userRole].add_task is defined and roles[userRole].add_task %}
                <div class="mb-4">
                    <a class="color-yellow text-20 text-bold js-inline-add-toggle" href="#" data-target="#inlineAddTaskNwP1Row"><i class="fas fa-plus-circle"></i>&nbsp; Ajouter une tâche</a>
                </div>
            {% endif %}

            {% if roles[userRole].add_task is defined and roles[userRole].add_task %}
                {% set inlineAddConfig = {
                    submitUrl: path('next_week_p1'),
                    rowSelector: '#inlineAddTaskNwP1Row',
                    errorRowSelector: '#inlineAddTaskNwP1Errors',
                    hasActions: showActions,
                    reorderUrl: path('reorder'),
                    actions: [
                        {
                            enabled: roles[userRole].task_p1_to_p2_nw is defined and roles[userRole].task_p1_to_p2_nw,
                            urlTemplate: path('change_task_nw_p1_to_p2', {'id': 'TASK_ID'}),
                            className: 'color-yellow text-bold',
                            text: 'P2',
                            wrapText: true
                        },
                        {
                            enabled: roles[userRole].task_p1_nw_to_p1_cw_button is defined and roles[userRole].task_p1_nw_to_p1_cw_button,
                            urlTemplate: path('change_task_p1_nw_to_p1_cw', {'id': 'TASK_ID'}),
                            className: 'color-yellow',
                            iconClass: 'fas fa-undo'
                        },
                        {
                            enabled: roles[userRole].task_p1_modify_nw is defined and roles[userRole].task_p1_modify_nw,
                            urlTemplate: '#',
                            className: 'color-yellow',
                            iconClass: 'fas fa-cog',
                            inlineEdit: true
                        },
                        {
                            enabled: roles[userRole].task_p1_delete_nw is defined and roles[userRole].task_p1_delete_nw,
                            urlTemplate: path('delete_task_nw_p1', {'id': 'TASK_ID'}),
                            className: 'color-yellow',
                            iconClass: 'fas fa-trash',
                            confirm: 'Attention, vous vous apprêtez à supprimer une tâche P1'
                        }
                    ]
                } %}
                {{ form_start(form_task_nw_p1_add, {'attr': {'id': 'inlineAddTaskNwP1Form', 'data-task-inline-config': inlineAddConfig|json_encode|e('html_attr')}}) }}
            {% endif %}

            <table id="tableOrderTaskP1" class="table mb-5 table-bordered">
                <thead class="bg-blue-dark-light table-borderless" border-right-style: none;>
                    <tr style="border-right-style: none;">
                        <th class="color-yellow text-bold d-none" data-field="id" data-visible="false">ID</th>
                        <th class="color-yellow text-bold" data-field="customer" data-sortable="true" scope="col">Client</th>
                        <th class="color-yellow text-bold" data-field="subject"  data-sortable="true" scope="col">Sujet</th>
                        <th  class="color-yellow text-bold"data-field="person" data-sortable="true" scope="col">Équipe</th>
                        <th class="color-yellow text-bold" data-field="deadline" data-sortable="true" scope="col">Deadline</th>
                        <th class="color-yellow text-bold" data-field="note" data-sortable="true" scope="col">Note</th>
                        {% if userRole is not null and roles[userRole] is defined %}
                            {% set showActions =
                            roles[userRole].task_p1_to_p2_nw is defined and roles[userRole].task_p1_to_p2_nw or
                            roles[userRole].task_p1_nw_to_p1_cw_button is defined and roles[userRole].task_p1_nw_to_p1_cw_button or
                            roles[userRole].task_p1_modify_nw is defined and roles[userRole].task_p1_modify_nw or
                            roles[userRole].task_p1_delete_nw is defined and roles[userRole].task_p1_delete_nw
                            %}

                            {% if showActions %}
                                <th class="color-yellow" scope="col">Action</th>
                            {% endif %}
                    
                        {% endif %}
                 
                    </tr>
                </thead>
                <tbody class="bg-blue-dark">
                    {% if roles[userRole].add_task is defined and roles[userRole].add_task and show_inline_add_form|default(false) %}
                        <tr>
                            <td colspan="{{ inlineAddCols }}" class="bg-blue-dark-light text-left">{{ form_errors(form_task_nw_p1_add) }}</td>
                        </tr>
                    {% endif %}

                    {% if roles[userRole].add_task is defined and roles[userRole].add_task %}
                        <tr id="inlineAddTaskNwP1Row" class="bg-blue-dark-light {% if not show_inline_add_form|default(false) %}d-none{% endif %}">
                            <td class="d-none"></td>
                            <td>
                                {{ form_widget(form_task_nw_p1_add.customer, {'attr': {'class': 'form-select form-select-sm js-task-customer-select', 'data-customer-create-url': path('front_customer_create')}}) }}
                            </td>
                            <td>
                                {{ form_widget(form_task_nw_p1_add.object, {'attr': {'class': 'form-control form-control-sm', 'placeholder': 'Sujet'}}) }}
                                <div class="d-none">
                                    {{ form_widget(form_task_nw_p1_add.subobject1) }}
                                    {{ form_widget(form_task_nw_p1_add.subobject2) }}
                                    {{ form_widget(form_task_nw_p1_add.subobject3) }}
                                    {{ form_widget(form_task_nw_p1_add.p1) }}
                                    {{ form_widget(form_task_nw_p1_add.nextweek) }}
                                </div>
                            </td>
                            <td>
                                {{ form_widget(form_task_nw_p1_add.users, {'attr': {'class': 'form-select form-select-sm js-task-users-select', 'size': '4'}}) }}
                            </td>
                            <td>
                                {{ form_widget(form_task_nw_p1_add.deadline, {'attr': {'class': 'form-control form-control-sm'}}) }}
                            </td>
                            <td>
                                {{ form_widget(form_task_nw_p1_add.note, {'attr': {'class': 'form-control form-control-sm', 'placeholder': 'Note'}}) }}
                            </td>
                            {% if showActions %}
                                <td>
                                    {{ form_widget(form_task_nw_p1_add.submit, {'attr': {'class': 'btn-yellow-form text-bold'}}) }}
                                    <button type="button" class="btn btn-outline-light btn-sm js-inline-add-cancel" data-target="#inlineAddTaskNwP1Row">Annuler</button>
                                </td>
                            {% endif %}
                        </tr>

                        <tr id="inlineAddTaskNwP1Errors" class="d-none bg-blue-dark-light">
                            <td colspan="{{ inlineAddCols }}">
                                <div class="message-error"></div>
                            </td>
                        </tr>

                        <tr id="inlineEditTaskNwP1Row" class="bg-blue-dark-light d-none" data-source-task-id="">
                            <td class="d-none"></td>
                            <td>
                                <select class="form-select form-select-sm js-inline-edit-customer">
                                    <option value="">Client</option>
                                    {% for customer in customers %}
                                        <option value="{{ customer.id }}">{{ customer.name }}</option>
                                    {% endfor %}
                                </select>
                            </td>
                            <td>
                                <input type="text" class="form-control form-control-sm js-inline-edit-object" placeholder="Sujet">
                                <input type="hidden" class="js-inline-edit-subobject1">
                                <input type="hidden" class="js-inline-edit-subobject2">
                                <input type="hidden" class="js-inline-edit-subobject3">
                            </td>
                            <td>
                                <select class="form-select form-select-sm js-inline-edit-users" multiple size="4">
                                    {% for userItem in usersList %}
                                        <option value="{{ userItem.id }}">{{ userItem.firstname }}</option>
                                    {% endfor %}
                                </select>
                            </td>
                            <td>
                                <input type="datetime-local" class="form-control form-control-sm js-inline-edit-deadline">
                            </td>
                            <td>
                                <input type="text" class="form-control form-control-sm js-inline-edit-note" placeholder="Note">
                            </td>
                            {% if showActions %}
                                <td>
                                    <button type="button" class="btn-yellow-form text-bold js-inline-edit-save">Valider</button>
                                    <button type="button" class="btn btn-outline-light btn-sm js-inline-edit-cancel">Annuler</button>
                                </td>
                            {% endif %}
                        </tr>

                        <tr id="inlineEditTaskNwP1Errors" class="d-none bg-blue-dark-light">
                            <td colspan="{{ inlineAddCols }}">
                                <div class="message-error"></div>
                            </td>
                        </tr>
                    {% endif %}

                    {% for task in task %}
                        {% if task.p1 == 1 and task.p2 == 0 and task.nextweek == 1 %}
                            {% set userIds = [] %}
                            {% for userRef in task.users %}
                                {% set userIds = userIds|merge([userRef.id]) %}
                            {% endfor %}
                            <tr
                                data-task-id="{{ task.id }}"
                                data-customer-id="{{ task.customer ? task.customer.id : '' }}"
                                data-object="{{ task.object|default('')|e('html_attr') }}"
                                data-subobject1="{{ task.subObject1|default('')|e('html_attr') }}"
                                data-subobject2="{{ task.subObject2|default('')|e('html_attr') }}"
                                data-subobject3="{{ task.subObject3|default('')|e('html_attr') }}"
                                data-user-ids="{{ userIds|join(',') }}"
                                data-deadline-value="{{ task.deadline ? task.deadline|date('Y-m-d\\TH:i') : '' }}"
                                data-note="{{ task.note|default('')|e('html_attr') }}">
                                <td class="d-none">{{ task.id }}</td>
                                <td class="color-white text-bold">{{task.customer}}</td>
                                <td class="color-white text-bold">
                                    {% if task.object is empty %}{% else %}{{task.object}}<br>{% endif %}
                                    {% if task.subobject1 is empty %}{% else %}{{task.subobject1}}<br>{% endif %} 
                                    {% if task.subobject1 is empty %}{% else %}{{task.subobject2}}<br>{% endif %}
                                    {% if task.subobject1 is empty %}{% else %}{{task.subobject3}}{% endif %}
                                </td>
                                <td class="color-white text-bold">{% for task in task.users %}
                                        {{ task.firstname }} <br>
                                    {% endfor %}
                                </td>
                                <td class="color-white text-bold">{{ task.deadline ? task.deadline|date('d/m/Y H:i') : '' }}</td>
                                <td class="color-white text-bold">{{ task.note }}</td>
                                {% if userRole is not null and roles[userRole] is defined %}
                                {% set showActions =
                                
                                roles[userRole].task_p1_to_p2_nw is defined and roles[userRole].task_p1_to_p2_nw or
                                roles[userRole].task_p1_nw_to_p1_cw_button is defined and roles[userRole].task_p1_nw_to_p1_cw_button or
                                roles[userRole].task_p1_modify_nw is defined and roles[userRole].task_p1_modify_nw or
                                roles[userRole].task_p1_delete_nw is defined and roles[userRole].task_p1_delete_nw
                                %}
                                    {% if showActions %}
                                        <td>
                                            <div style="display:inline-flex;align-items:center;column-gap:8px;">
                                            {% if roles[userRole].task_p1_to_p2_nw is defined and roles[userRole].task_p1_to_p2_nw %}
                                                <a class="color-yellow text-bold" href="{{ path('change_task_nw_p1_to_p2', {'id': task.id}) }}"><span>P2</span></a>
                                            {% endif %}

                                            {% if roles[userRole].task_p1_nw_to_p1_cw_button is defined and roles[userRole].task_p1_nw_to_p1_cw_button %}
                                                <a class="color-yellow" href="{{ path('change_task_p1_nw_to_p1_cw', {'id': task.id}) }}"><i class="fas fa-undo"></i></a>
                                            {% endif %}
                                            
                                            {% if roles[userRole].task_p1_modify_nw is defined and roles[userRole].task_p1_modify_nw %}
                                                <a class="color-yellow js-inline-edit-toggle" href="#" data-task-id="{{ task.id }}"><i class="fas fa-cog"></i></a>
                                            {% endif %}
                                                
                                            {% if roles[userRole].task_p1_delete_nw is defined and roles[userRole].task_p1_delete_nw %}
                                                <a class="color-yellow" href="{{ path('delete_task_nw_p1', {'id': task.id}) }}" onclick="return confirm('Attention, vous vous apprêtez à supprimer une tâche P1')"><i class="fas fa-trash"></i></a>
                                            {% endif %}
                                            </div>
                                        </td>
                                    {% endif %}
                                {% endif %}                             
                                
                                </tr>
                            </tr>
                        {% endif %}
                    {% endfor %}
                </tbody>
            </table>

            {% if roles[userRole].add_task is defined and roles[userRole].add_task %}
                {{ form_end(form_task_nw_p1_add) }}
            {% endif %}

                {% if roles[userRole].show_switch_to_cw is defined and roles[userRole].show_switch_to_cw %}
					{% if task is empty and appointment is empty %}
						<div style="pointer-events: none" class="mt-5 text-center color-yellow"><span>Il faut au moins une donnée pour faire le basculement</span></div>
					{% else %}			
						<a class="mt-3 text-center btn-yellow btn" href="{{ path('mission_nw_change_to_cw_front') }}">Basculer en semaine actuelle</a>
					{% endif %}
                {% endif %}
				
        </div>

	</div>
{%  endblock %}
{% block javascripts %}
	{{ parent() }}
    <script>
        window.nextWeekP1InlineUpdateUrlTemplate = "{{ path('next_week_p1_inline_update', {'id': 'TASK_ID'}) }}";
    </script>
	<script src="{{ asset('assets/js/task-inline-add.js') }}?v=20260527"></script>
    <script src="{{ asset('assets/js/task-inline-edit-nextweek-p1.js') }}?v=20260528a"></script>
{% endblock %}