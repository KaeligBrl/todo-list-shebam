{% extends 'base_login_register.html.twig' %}

{% block title %}Nouveau mot de passe - {% block title_base %}{{ parent() }}{% endblock %}{% endblock %}
{% block content %}
    {% block body %}
        <a href="{{ path('home') }}">
            <img class="d-block mx-auto mb-4 auth-logo" src="{{ asset('/assets/images/logo-todo.png') }}" alt="Logo de connexion To Do List">
        </a>

        <div class="container-custom text-center">
            <h1 class="mb-1 auth-page-title">Nouveau mot de passe</h1>
            <div class="separator mb-4"></div>

			<div class="form-general">
				{{ form_start(resetForm) }}
				<div class="form-group mb-3">
					<label class="text-white mb-1 auth-form-label">Mot de passe</label>
					<div class="showHiddenPassword-wrapper">
						{{ form_widget(resetForm.plainPassword.first, {'attr': {'id': 'reset_password_first', 'class': 'form-control', 'placeholder': 'Mon nouveau mot de passe'}}) }}
						<span class="showHiddenPassword-toggle" data-target="#reset_password_first" role="button" aria-label="Afficher ou masquer le mot de passe" title="Afficher ou masquer le mot de passe">
							<i class="fa fa-eye-slash"></i>
						</span>
					</div>
					{{ form_errors(resetForm.plainPassword.first) }}
				</div>

				<div class="form-group mb-4">
					<label class="text-white mb-1 auth-form-label">Confirmation du mot de passe</label>
					<div class="showHiddenPassword-wrapper">
						{{ form_widget(resetForm.plainPassword.second, {'attr': {'id': 'reset_password_second', 'class': 'form-control', 'placeholder': 'Confirmation du mot de passe'}}) }}
						<span class="showHiddenPassword-toggle" data-target="#reset_password_second" role="button" aria-label="Afficher ou masquer le mot de passe" title="Afficher ou masquer le mot de passe">
							<i class="fa fa-eye-slash"></i>
						</span>
					</div>
					{{ form_errors(resetForm.plainPassword.second) }}
				</div>
				<div class="text-center">
					{{ form_widget(resetForm.submit, {'attr': {'class': 'btn btn-submit w-100 auth-submit-btn'}}) }}
				</div>
				{{ form_end(resetForm, {'render_rest': false}) }}
			</div>
		</div>
    {% endblock %}
{% endblock %}
