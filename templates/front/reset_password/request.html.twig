{% extends 'base_login_register.html.twig' %}

{% block title %}Mot de passe oublié - {% block title_base %}{{ parent() }}{% endblock %}{% endblock %}


{% block content %}

    <a href="{{ path('home') }}">
        <img class="d-block mx-auto mb-4 auth-logo" src="{{ asset('/assets/images/logo-todo.png') }}" alt="Logo de connexion To Do List">
    </a>

    <div class="container-custom text-center">
        <h1 class="mb-1 auth-page-title">Mot de passe oublié</h1>
        <div class="separator mb-4"></div>

		{% for flashError in app.flashes('reset_password_error') %}
			<div class="message-error text-center mb-3" role="alert">{{ flashError }}</div>
		{% endfor %}

        <div class="form-general">
            {{ form_start(requestForm) }}
            <div class="form-group mb-4">
                {{ form_widget(requestForm.email, {'attr': {'class': 'form-control', 'placeholder': 'votre@email.com'}}) }}
                {{ form_errors(requestForm.email) }}
            </div>
            <div class="text-center">
                {{ form_widget(requestForm.submit, {'attr': {'class': 'btn btn-submit w-100 auth-submit-btn'}}) }}
            </div>
            {{ form_end(requestForm) }}
        </div>

        <p class="text-center mt-4 mb-0">
            <span class="auth-muted-text">Deja inscrit ?</span>
            <a href="{{ path('home') }}" class="text-login-link ms-1 auth-link-text">Connectez-vous</a>
        </p>
    </div>

{% endblock %}

