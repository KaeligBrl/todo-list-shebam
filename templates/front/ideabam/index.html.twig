{% extends 'base.html.twig' %}
{% block title %}Idébam - {% block title_base %}{{ parent() }}{% endblock %}{% endblock %}

{% block content %}

<div class="mb-5">
    <img class="d-block mx-auto mb-3" style="width: 400px" src="{{ asset('/assets/images/logo-ideabam.png') }}" alt="Logo de connexion To Do List">
        <nav class="navbar navbar-expand-lg">
            <ul class="navbar-nav mx-auto " id="navbarqaqa">
                {% if app.user %}
            {% if userRole is not null and roles[userRole] is defined and roles[userRole].routes is defined and roles[userRole].routes.ideabam_waiting_return is defined and roles[userRole].routes.ideabam_waiting_return %}
            <li class="nav-item">
                <a class="
                                                    {% if app.request.attributes.get('_route') starts with 'next_week_p1' %}active-filters{% endif %}
                                                    {% if app.request.attributes.get('_route') starts with 'modify_task_p1_nw' %}active-filters{% endif %}
                                                    navbar-text text-uppercase text-margin"
                    href="{{ path('ideabam_waiting_return') }}">Attente retour <i class="color-white fas fa-tasks"></i></a>
            </li>
            {% endif %}
        {% endif %}
            </ul>
        </nav>
    <div class="container text-center padding-mobile">
        {% if app.user and userRole is not null and roles[userRole] is defined and roles[userRole].add_ideabam is defined and
        roles[userRole].add_ideabam %}
        <div class="mb-4">
            <a class="color-yellow text-20 text-bold" href="#ajouteruneidebam"><i class="fas fa-plus-circle"></i>&nbsp; Ajouter une idée</a>
        </div>
        {% endif %}
        {% set today = date() %}
        <p class="color-white">Prochaine réunion pour les idées le : {{ last_friday_of_month(today) }}</p>
    </div>

    <table id="tableOrderTaskP1" class="table mb-5 table-bordered" data-toggle="table" 
        {% if app.user and userRole is not null and roles[userRole] is defined %} data-use-row-attr-func="true" {% endif %}>
        <thead class="bg-blue-dark-light table-borderless" style="border-right-style: none;">
            <tr style="border-right-style: none;">
                <th class="color-yellow text-bold" data-field="subject" {% if app.user and userRole is not null and roles[userRole] is defined %} data-sortable="true" {% endif %} scope="col">Idée</th>
                <th class="color-yellow text-bold" data-field="object" {% if app.user and userRole is not null and roles[userRole] is defined %} data-sortable="true" {% endif %} scope="col">Objet</th>
                <th class="color-yellow text-bold" data-field="person" {% if app.user and userRole is not null and roles[userRole] is defined %} data-sortable="true" {% endif %} scope="col">Personne</th>
                {% if app.user and userRole is not null and roles[userRole] is defined and roles[userRole].routes is defined and (
                    (roles[userRole].routes.ideabam_to_waiting_return is defined and roles[userRole].routes.ideabam_to_waiting_return) or
                    (roles[userRole].routes.modify_ideabam is defined and roles[userRole].routes.modify_ideabam) or
                    (roles[userRole].routes.delete_ideabam is defined and roles[userRole].routes.delete_ideabam)
                ) %}
                <th class="color-yellow" scope="col">Action</th>
                {% endif %}
            </tr>
        </thead>
        <tbody class="bg-blue-dark">
            {% for idea in ideas %}
               
                    <tr>
                        <td class="color-white text-bold">{{ idea.subject }}</td>
                        <td class="color-white text-bold">{{ idea.object }}</td>
                        <td class="color-white text-bold">
                            {% for person in idea.person %}
                                {{ person.firstname }} <br>
                            {% endfor %}
                        </td>
                        {% if app.user and userRole is not null and roles[userRole] is defined and roles[userRole].routes is defined and (
                            (roles[userRole].routes.ideabam_to_waiting_return is defined and roles[userRole].routes.ideabam_to_waiting_return) or
                            (roles[userRole].routes.modify_ideabam is defined and roles[userRole].routes.modify_ideabam) or
                            (roles[userRole].routes.delete_ideabam is defined and roles[userRole].routes.delete_ideabam)
                        ) %}
                        <td>
                            {% if roles[userRole].routes.ideabam_to_waiting_return is defined and roles[userRole].routes.ideabam_to_waiting_return %}
                            <a class="color-yellow" href="{{ path('ideabam_to_waiting_return', {"id": idea.id}) }}"><i class="fas fa-hourglass-start"></i></a>&nbsp;
                            {% endif %}
                            {% if roles[userRole].routes.modify_ideabam is defined and roles[userRole].routes.modify_ideabam %}
                            <a class="color-yellow" href="{{ path('modify_ideabam', {"id": idea.id}) }}"><i class="fas fa-cog"></i></a>&nbsp;
                            {% endif %}
                            {% if roles[userRole].routes.delete_ideabam is defined and roles[userRole].routes.delete_ideabam %}
                            <a class="color-yellow" href="{{ path('delete_ideabam', {"id": idea.id}) }}" onclick="return confirm('Attention vous vous apprêtez à supprimer l\'idée')"><i class="fas fa-trash"></i></a>
                            {% endif %}
                        </td>
                        {% endif %}
                    </tr>
               
            {% endfor %}
        </tbody>
    </table>

    <!-- POPUP -->

    <div id="ajouteruneidebam" class="overlay">
        <div class="popup bg-blue-dark-light">
            <a class="close" href=""><i class="fas fa-times"></i></a>
            {{ form_start(form_idea_add) }}
            <div class="row">
                <div class="col">
                    {{ form_row(form_idea_add.subject) }}
                    {{ form_row(form_idea_add.object) }}
                </div>
                <div class="col">
                    <p class="color-yellow text-bold">Personne(s)</p>
                    <div class="bg-blue-dark text-left users">
                        {{ form_row(form_idea_add.person) }}
                    </div>
                    <div class="text-left mt-3 color-yellow">
                        {{ form_row(form_idea_add.waitingReturn) }}
                        {{ form_row(form_idea_add.submit) }}
                    </div>
                </div>
            </div>
            {{ form_end(form_idea_add) }}
        </div>
    </div>
</div>
{% endblock %}
