{% extends 'base.html.twig' %}

{% block content %}
    <title>{%  block title %}Semaine Actuelle - {% block title_base %}{{ parent() }}{% endblock %}{% endblock %}</title>
	<div class="mb-5">
        <img class="d-block mx-auto" style="width: 300px" src="{{ asset('/assets/images/logo-todo.png') }}"
            alt="Logo de connexion To Do List">
		<h1 class="text-center color-white mb-3">Semaine Actuelle</h1>
        <nav class="navbar navbar-expand-lg">
            <ul class="navbar-nav mx-auto">

                        <li class="nav-item"> 
                            <a class="
                                        {% if app.request.attributes.get('_route') starts with 'current_week_p1' %}active-filters{% endif %}
                                        {% if app.request.attributes.get('_route') starts with 'modify_task_p1_cw' %}active-filters{% endif %}
                                        navbar-text text-uppercase text-margin" href="{{ path('current_week_p1') }}">Priorité 1 <i class="color-white fas fa-tasks"></i></a>
                        </li>
                        <li class="nav-item"> 
                            <a class="navbar-text text-uppercase text-margin" href="{{ path('current_week_p2') }}">Priorité 2 <i class="color-white fas fa-tasks"></i></a>
                        </li>
                        <li class="nav-item">
                            <a class="navbar-text text-uppercase text-margin" href="{{ path('current_week_waiting_return') }}">Attente retour <i
                                    class="color-white fas fa-hourglass-start"></i></a>
                        </li>
                        <li class="nav-item"> 
                            <a class="navbar-text text-uppercase text-margin" href="{{ path('current_week_appointment') }}">Rendez-vous <i class="color-white far fa-calendar-check"></i></a>
                        </li>

            </ul> 
        </nav>
		<div class="container text-center padding-mobile">
            {% set showActions = false %}
            {% set showDoneButtonCw = false %}
            {% if userRole is not null and roles[userRole] is defined %}
                {% set showActions =
                    roles[userRole].waiting_return_in_p1_cw is defined and roles[userRole].waiting_return_in_p1_cw or
                    roles[userRole].task_p1_delete_button is defined and roles[userRole].task_p1_delete_button or
                    roles[userRole].task_p1_modify_button is defined and roles[userRole].task_p1_modify_button or
                    roles[userRole].task_p1_cw_to_p1_nw_button is defined and roles[userRole].task_p1_cw_to_p1_nw_button or
                    roles[userRole].p2_button_in_cw is defined and roles[userRole].p2_button_in_cw
                %}
                {% set showDoneButtonCw = roles[userRole].button_done is defined and roles[userRole].button_done %}
            {% endif %}
            {% set inlineAddCols = 6 + (showActions ? 1 : 0) + (showDoneButtonCw ? 1 : 0) %}

            {% if roles[userRole].add_task_cw is defined and roles[userRole].add_task_cw %}
                <div class="mb-4">
                    <a class="color-yellow text-20 text-bold js-inline-add-toggle" href="#" data-target="#inlineAddTaskP1Row"><i class="fas fa-plus-circle"></i>&nbsp; Ajouter une tâche</a>
                </div>
            {% endif %}

            {% if roles[userRole].add_task_cw is defined and roles[userRole].add_task_cw %}
                {% set inlineAddConfig = {
                    submitUrl: path('current_week_p1'),
                    rowSelector: '#inlineAddTaskP1Row',
                    errorRowSelector: '#inlineAddTaskP1Errors',
                    hasActions: showActions,
                    hasDone: showDoneButtonCw,
                    reorderUrl: path('reorder'),
                    actions: [
                        {
                            enabled: roles[userRole].task_p1_modify_button is defined and roles[userRole].task_p1_modify_button,
                            urlTemplate: path('modify_task_p1_cw', {'id': 'TASK_ID'}),
                            className: 'color-yellow',
                            iconClass: 'fas fa-cog'
                        },
                        {
                            enabled: roles[userRole].waiting_return_in_p1_cw is defined and roles[userRole].waiting_return_in_p1_cw,
                            urlTemplate: path('to_p1_from_waiting_return_cw', {'id': 'TASK_ID'}),
                            className: 'color-yellow',
                            iconClass: 'fas fa-hourglass-start'
                        },
                        {
                            enabled: roles[userRole].task_p1_cw_to_p1_nw_button is defined and roles[userRole].task_p1_cw_to_p1_nw_button,
                            urlTemplate: path('change_task_p1_cw_to_p1_nw', {'id': 'TASK_ID'}),
                            className: 'color-yellow',
                            iconClass: 'fas fa-redo'
                        },
                        {
                            enabled: roles[userRole].p2_button_in_cw is defined and roles[userRole].p2_button_in_cw,
                            urlTemplate: path('change_task_cw_p1_to_p2', {'id': 'TASK_ID'}),
                            text: 'P2'
                        },
                        {
                            enabled: roles[userRole].task_p1_delete_button is defined and roles[userRole].task_p1_delete_button,
                            urlTemplate: path('delete_task_cw_p1', {'id': 'TASK_ID'}),
                            className: 'color-yellow',
                            iconClass: 'fas fa-trash',
                            confirm: 'Attention, vous vous apprêtez à supprimer une tâche P1'
                        }
                    ]
                } %}
                {{ form_start(form_task_cw_p1_add, {'attr': {'id': 'inlineAddTaskP1Form', 'data-task-inline-config': inlineAddConfig|json_encode|e('html_attr')}}) }}
            {% endif %}

            <table id="tableOrderTaskP1" class="table mb-5 table-bordered">
                <thead class="bg-blue-dark-light table-borderless">
                    <tr>
                        <th class="color-yellow text-bold d-none" data-field="id" data-visible="false">ID</th>
                        <th class="color-yellow text-bold" data-field="customer" data-sortable="true" scope="col">Client</th>
                        <th class="color-yellow text-bold" data-field="subject" data-sortable="true" scope="col">Sujet</th>
                        <th  class="color-yellow text-bold"data-field="person"data-sortable="true" scope="col">Équipe</th>
                        <th class="color-yellow text-bold" data-field="deadline" data-sortable="true" scope="col">Deadline</th>
                        <th class="color-yellow text-bold" data-field="note" data-sortable="true" scope="col">Note</th>
                        
                        {% if userRole is not null and roles[userRole] is defined %}
                            {% set showActions =
                            roles[userRole].waiting_return_in_p1_cw is defined and roles[userRole].waiting_return_in_p1_cw or
                            roles[userRole].task_p1_delete_button is defined and roles[userRole].task_p1_delete_button or
                            roles[userRole].task_p1_modify_button is defined and roles[userRole].task_p1_modify_button or
                            roles[userRole].task_p1_cw_to_p1_nw_button is defined and roles[userRole].task_p1_cw_to_p1_nw_button or
                            roles[userRole].p2_button_in_cw is defined and roles[userRole].p2_button_in_cw
                            %}

                            {% if showActions %}
                                <th class="color-yellow" scope="col">Action</th>
                            {% endif %}

                            {% set showDoneButtonCw = roles[userRole].button_done is defined and roles[userRole].button_done
                            %}
                        
                            {% if showDoneButtonCw %}
                                <th class="color-yellow" scope="col">Fait</th>
                            {% endif %}
                        {% endif %}
                        
                        
                    </tr>
                </thead>
                <tbody class="bg-blue-dark">
                    {% if roles[userRole].add_task_cw is defined and roles[userRole].add_task_cw and show_inline_add_form|default(false) %}
                        <tr>
                            <td colspan="{{ inlineAddCols }}" class="bg-blue-dark-light text-left">{{ form_errors(form_task_cw_p1_add) }}</td>
                        </tr>
                    {% endif %}

                    {% if roles[userRole].add_task_cw is defined and roles[userRole].add_task_cw %}
                        <tr id="inlineAddTaskP1Row" class="bg-blue-dark-light {% if not show_inline_add_form|default(false) %}d-none{% endif %}">
                            <td class="d-none"></td>
                            <td>
                                {{ form_widget(form_task_cw_p1_add.customer, {'attr': {'class': 'form-select form-select-sm js-task-customer-select', 'data-customer-create-url': path('front_customer_create')}}) }}
                            </td>
                            <td>
                                {{ form_widget(form_task_cw_p1_add.object, {'attr': {'class': 'form-control form-control-sm', 'placeholder': 'Sujet'}}) }}
                                <div class="d-none">
                                    {{ form_widget(form_task_cw_p1_add.subobject1) }}
                                    {{ form_widget(form_task_cw_p1_add.subobject2) }}
                                    {{ form_widget(form_task_cw_p1_add.subobject3) }}
                                </div>
                            </td>
                            <td>
                                {{ form_widget(form_task_cw_p1_add.users, {'attr': {'class': 'form-select form-select-sm js-task-users-select', 'size': '4'}}) }}
                            </td>
                            <td>
                                {{ form_widget(form_task_cw_p1_add.deadline, {'attr': {'class': 'form-control form-control-sm'}}) }}
                            </td>
                            <td>
                                {{ form_widget(form_task_cw_p1_add.note, {'attr': {'class': 'form-control form-control-sm', 'placeholder': 'Note'}}) }}
                            </td>
                            {% if showActions %}
                                <td>
                                    <div class="d-none">{{ form_widget(form_task_cw_p1_add.p1) }}</div>
                                    {{ form_widget(form_task_cw_p1_add.submit, {'attr': {'class': 'btn-yellow-form text-bold'}}) }}
                                    <button type="button" class="btn btn-outline-light btn-sm js-inline-add-cancel" data-target="#inlineAddTaskP1Row">Annuler</button>
                                </td>
                            {% endif %}
                            {% if showDoneButtonCw %}
                                <td></td>
                            {% endif %}
                        </tr>

                        <tr id="inlineAddTaskP1Errors" class="d-none bg-blue-dark-light">
                            <td colspan="{{ inlineAddCols }}">
                                <div class="message-error"></div>
                            </td>
                        </tr>
                    {% endif %}

                    {% for task in task %}
                        {% if task.p1 == 1 and task.p2 == 0 and task.nextweek == 0 %}
                            <tr class="{% if task.done == 1 %}bg-yellow-dark {% endif %}"  data-taskdone="{{task.id}}">

                                <td class="d-none">{{ task.id }}</td>

                                <td class="color-white text-bold">{{task.customer}}</td>

                                <td class="color-white text-bold">
                                    {% if task.object is empty %}{% else %}{{task.object}}<br>{% endif %}
                                    {% if task.subobject1 is empty %}{% else %}{{task.subobject1}}<br>{% endif %} 
                                    {% if task.subobject1 is empty %}{% else %}{{task.subobject2}}<br>{% endif %}
                                    {% if task.subobject1 is empty %}{% else %}{{task.subobject3}}{% endif %}
                                </td>

                                <td class="color-white text-bold">{% for task in task.users %}
                                        {{ task.firstname }} <br>
                                    {% endfor %}
                                </td>

                                <td class="color-white text-bold">{{ task.deadline ? task.deadline|date('d/m/Y H:i') : '' }}</td>

                                <td class="color-white text-bold">{{ task.note }}</td>


                                {% if userRole is not null and roles[userRole] is defined %}
                                {% set showActions =

                                roles[userRole].waiting_return_in_p1_cw is defined and roles[userRole].waiting_return_in_p1_cw or
                                roles[userRole].task_p1_delete_button is defined and roles[userRole].task_p1_delete_button or
                                roles[userRole].task_p1_modify_button is defined and roles[userRole].task_p1_modify_button or
                                roles[userRole].task_p1_cw_to_p1_nw_button is defined and roles[userRole].task_p1_cw_to_p1_nw_button or
                                roles[userRole].p2_button_in_cw is defined and roles[userRole].p2_button_in_cw
                                %}
                                    {% if showActions %}
                                        <td>
                                            <div style="display:inline-flex;align-items:center;column-gap:8px;">
                                            {% if roles[userRole].task_p1_modify_button is defined and roles[userRole].task_p1_modify_button %}
                                            <a class="color-yellow" href="{{ path('modify_task_p1_cw', {'id': task.id}) }}">
                                                <i class="fas fa-cog"></i>
                                            </a>
                                            {% endif %}

                                            {% if roles[userRole].waiting_return_in_p1_cw is defined and roles[userRole].waiting_return_in_p1_cw %}
                                            <a class="color-yellow" href="{{ path('to_p1_from_waiting_return_cw', {'id': task.id }) }}"><i
                                                    class="fas fa-hourglass-start"></i></a>
                                            {% endif %}

                                            {% if roles[userRole].task_p1_cw_to_p1_nw_button is defined and roles[userRole].task_p1_cw_to_p1_nw_button  %}
                                            <a class="color-yellow" href="{{ path('change_task_p1_cw_to_p1_nw', {'id': task.id}) }}">
                                                <i class="fas fa-redo"></i>
                                            </a>
                                            {% endif %}

                                            {% if roles[userRole].p2_button_in_cw is defined and roles[userRole].p2_button_in_cw %}
                                            <a href="{{ path('change_task_cw_p1_to_p2', {'id': task.id}) }}">P2</a>
                                            {% endif %}

                                            {% if roles[userRole].task_p1_delete_button is defined and roles[userRole].task_p1_delete_button %}
                                            <a class="color-yellow" href="{{ path('delete_task_cw_p1', {'id': task.id}) }}"
                                                onclick="return confirm('Attention, vous vous apprêtez à supprimer une tâche P1')">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                            {% endif %}
                                            </div>
                                        </td>
                                    {% endif %}
                                {% endif %}

                           
                                {% set showDoneButtonCw = roles[userRole].button_done is defined and roles[userRole].button_done %}
                                {% if showDoneButtonCw %}
                                    <td class="form-switch">
                                        {% if roles[userRole].button_done is defined and roles[userRole].button_done %}
                                            <input type="checkbox" id="taskdone" class="taskdone" {{ (task.done) ? 'checked' : ''}} data-taskdone="{{task.id}}">
                                        {% endif %}
                                    </td>
                                </tr>
                                {% endif %}
                        {% endif %}
                    {% endfor %}
                </tbody>
            </table>

            {% if roles[userRole].add_task_cw is defined and roles[userRole].add_task_cw %}
                {{ form_end(form_task_cw_p1_add) }}
            {% endif %}

            {% if roles[userRole].generate_archive_task is defined and roles[userRole].generate_archive_task %}
                {% if task is empty and appointment is empty %}
                    <div style="pointer-events: none" class="mt-3 text-center color-yellow"><span>Il faut au moins une donnée pour générer le téléchargement</span></div>
                {% else %}			
                    <a class="mt-3 text-center btn-yellow btn" href="{{ path('download') }}">Générer le téléchargement</a>
                {% endif %}
            {% endif %}
        </div>

	</div>
{%  endblock %}

{% block javascripts %}
{{ parent() }}
<script src="{{ asset('assets/js/task-inline-add.js') }}?v=20260527"></script>
{% endblock %}