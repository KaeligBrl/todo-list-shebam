{% extends 'base.html.twig' %}

{% block content %}
    <title>{%  block title %}Semaine Actuelle - {% block title_base %}{{ parent() }}{% endblock %}{% endblock %}</title>
	<div class="mb-5">
        <img class="d-block mx-auto" style="width: 300px" src="{{ asset('/assets/images/logo-todo.png') }}"
            alt="Logo de connexion To Do List">
		<h1 class="text-center color-white mb-3">Semaine Actuelle</h1>
        <nav class="navbar navbar-expand-lg">
            <ul class="navbar-nav mx-auto " id="navbarqaqa">
                        <li class="nav-item"> 
                            <a class="navbar-text text-uppercase text-margin" href="{{ path('current_week_p1') }}">Priorité 1 <i class="color-white fas fa-tasks"></i></a>
                        </li>
                        <li class="nav-item"> 
                            <a class="
                                        {% if app.request.attributes.get('_route') starts with 'current_week_p2' %}active-filters{% endif %}
                                        {% if app.request.attributes.get('_route') starts with 'modify_task_p2_cw' %}active-filters{% endif %}
                                        navbar-text text-uppercase text-margin" href="{{ path('current_week_p2') }}">Priorité 2 <i class="color-white fas fa-tasks"></i></a>
                        </li>
                        <li class="nav-item"> 
                            <a class="navbar-text text-uppercase text-margin" href="{{ path('current_week_waiting_return') }}">Attente retour <i class="color-white fas fa-hourglass-start"></i></a>
                        </li>
                        <li class="nav-item"> 
                            <a class="navbar-text text-uppercase text-margin" href="{{ path('current_week_appointment') }}">Rendez-vous <i class="color-white far fa-calendar-check"></i></a></a>
                        </li>
            </ul>
        </nav>
		<div class="container text-center padding-dopdown-mobile">
            {% set showActions = false %}
            {% set showDoneButtonCw = false %}
            {% if userRole is not null and roles[userRole] is defined %}
                {% set showActions =
                    roles[userRole].waiting_return_in_p2_cw is defined and roles[userRole].waiting_return_in_p2_cw or
                    roles[userRole].task_p2_cw_to_p1_nw_button is defined and roles[userRole].task_p2_cw_to_p1_nw_button or
                    roles[userRole].p1_button_in_p2_cw is defined and roles[userRole].p1_button_in_p2_cw or
                    roles[userRole].task_p2_modify_button is defined and roles[userRole].task_p2_modify_button or
                    roles[userRole].task_p2_delete_button is defined and roles[userRole].task_p2_delete_button
                %}
                {% set showDoneButtonCw = roles[userRole].button_done is defined and roles[userRole].button_done %}
            {% endif %}
            {% set inlineAddCols = 4 + (showActions ? 1 : 0) + (showDoneButtonCw ? 1 : 0) %}

            <div class="mb-4">
                <a class="color-yellow text-20 text-bold js-inline-add-toggle" href="#" data-target="#inlineAddTaskP2Row"><i class="fas fa-plus-circle"></i>&nbsp; Ajouter une tâche</a>
            </div>

            {{ form_start(form_task_cw_p2_add, {'attr': {'id': 'inlineAddTaskP2Form'}}) }}
            
            <table id="tableOrderTaskP1" class="table mb-5 table-bordered">
                <thead class="bg-blue-dark-light table-borderless" border-right-style: none;>
                    <tr style="border-right-style: none;">
                        <th class="color-yellow text-bold d-none" data-field="id" data-visible="false">ID</th>
                        <th class="color-yellow text-bold" data-field="customer" data-sortable="true" scope="col">Client</th>
                        <th class="color-yellow text-bold" data-field="subject" data-sortable="true" scope="col">Sujet</th>
                        <th  class="color-yellow text-bold"data-field="person" data-sortable="true" scope="col">Équipe</th>

                        {% if userRole is not null and roles[userRole] is defined %}
                            {% set showActions =
                            roles[userRole].waiting_return_in_p2_cw is defined and roles[userRole].waiting_return_in_p2_cw or
                            roles[userRole].task_p2_cw_to_p1_nw_button is defined and roles[userRole].task_p2_cw_to_p1_nw_button or
                            roles[userRole].p1_button_in_p2_cw is defined and roles[userRole].p1_button_in_p2_cw or
                            roles[userRole].task_p2_modify_button is defined and roles[userRole].task_p2_modify_button or
                            roles[userRole].task_p2_delete_button is defined and roles[userRole].task_p2_delete_button
                            %}

                            {% if showActions %}
                                <th class="color-yellow" scope="col">Action</th>
                            {% endif %}

                            {% set showDoneButtonCw = roles[userRole].button_done is defined and roles[userRole].button_done
                            %}
                        
                            {% if showDoneButtonCw %}
                                <th class="color-yellow" scope="col">Fait</th>
                            {% endif %}
                        {% endif %}
                    </tr>
                </thead>
                <tbody class="bg-blue-dark">
                    {% if show_inline_add_form|default(false) %}
                        <tr>
                            <td colspan="{{ inlineAddCols }}" class="bg-blue-dark-light text-left">{{ form_errors(form_task_cw_p2_add) }}</td>
                        </tr>
                    {% endif %}

                    <tr id="inlineAddTaskP2Row" class="bg-blue-dark-light {% if not show_inline_add_form|default(false) %}d-none{% endif %}">
                        <td class="d-none"></td>
                        <td>
                            {{ form_widget(form_task_cw_p2_add.customer, {'attr': {'class': 'form-select form-select-sm'}}) }}
                        </td>
                        <td>
                            {{ form_widget(form_task_cw_p2_add.object, {'attr': {'class': 'form-control form-control-sm', 'placeholder': 'Sujet'}}) }}
                            <div class="d-none">
                                {{ form_widget(form_task_cw_p2_add.subobject1) }}
                                {{ form_widget(form_task_cw_p2_add.subobject2) }}
                                {{ form_widget(form_task_cw_p2_add.subobject3) }}
                            </div>
                        </td>
                        <td>
                            {{ form_widget(form_task_cw_p2_add.users, {'attr': {'class': 'form-select form-select-sm', 'size': '4'}}) }}
                        </td>
                        {% if showActions %}
                            <td>
                                <div class="d-none">{{ form_widget(form_task_cw_p2_add.p2) }}</div>
                                {{ form_widget(form_task_cw_p2_add.submit, {'attr': {'class': 'btn-yellow-form text-bold'}}) }}
                                <button type="button" class="btn btn-outline-light btn-sm js-inline-add-cancel" data-target="#inlineAddTaskP2Row">Annuler</button>
                            </td>
                        {% endif %}
                        {% if showDoneButtonCw %}
                            <td></td>
                        {% endif %}
                    </tr>

                    <tr id="inlineAddTaskP2Errors" class="d-none bg-blue-dark-light">
                        <td colspan="{{ inlineAddCols }}">
                            <div class="message-error"></div>
                        </td>
                    </tr>

                    {% for task in task %}
                        {% if task.p1 == 0 and task.p2 == 1 and task.nextweek == 0 %}
                            <tr class="popKeke {% if task.done == 1 %}bg-yellow-dark{% endif %}" data-taskdone="{{task.id}}">
                                <td class="d-none">{{ task.id }}</td>
                                <td class="color-white text-bold">{{task.customer}}</td>
                                <td class="color-white text-bold">
                                    {% if task.object is empty %}{% else %}{{task.object}}<br>{% endif %}
                                    {% if task.subobject1 is empty %}{% else %}{{task.subobject1}}<br>{% endif %} 
                                    {% if task.subobject1 is empty %}{% else %}{{task.subobject2}}<br>{% endif %}
                                    {% if task.subobject1 is empty %}{% else %}{{task.subobject3}}{% endif %}
                                </td>
                                <td class="color-white text-bold">
                                    {% for task in task.users %}
                                        {{ task.firstname }} <br>
                                    {% endfor %}
                                </td>

                                {% if userRole is not null and roles[userRole] is defined %}
                                    {% set showActions =
                                    
                                    roles[userRole].waiting_return_in_p2_cw is defined and roles[userRole].waiting_return_in_p2_cw or
                                    roles[userRole].task_p2_cw_to_p1_nw_button is defined and roles[userRole].task_p2_cw_to_p1_nw_button or
                                    roles[userRole].p1_button_in_p2_cw is defined and roles[userRole].p1_button_in_p2_cw or
                                    roles[userRole].task_p2_modify_button is defined and roles[userRole].task_p2_modify_button or
                                    roles[userRole].task_p2_delete_button is defined and roles[userRole].task_p2_delete_button
                                    %}
                                    {% if showActions %}
                                        <td>
                                            <div style="display:inline-flex;align-items:center;column-gap:8px;">
                                            {% if roles[userRole].waiting_return_in_p2_cw is defined and roles[userRole].waiting_return_in_p2_cw %}
                                            <a class="color-yellow" href="{{ path('to_p2_from_waiting_return_cw', {"id": task.id }) }}"><i class="fas fa-hourglass-start"></i></a>
                                            {% endif %}

                                            {% if roles[userRole].task_p2_cw_to_p1_nw_button is defined and roles[userRole].task_p2_cw_to_p1_nw_button %}
                                                <a class="color-yellow text-bold" href="{{ path('change_task_cw_to_p1', {"id": task.id}) }}"><span>P1</span></a>
                                            {% endif %}

                                            {% if roles[userRole].p1_button_in_p2_cw is defined and roles[userRole].p1_button_in_p2_cw %}
                                                <a class="color-yellow" href="{{ path('change_task_p2_cw_to_p2_nw', {"id": task.id}) }}"><i class="fas fa-redo"></i></a>
                                            {% endif %}

                                            {% if roles[userRole].task_p2_modify_button is defined and roles[userRole].task_p2_modify_button %}
                                                <a class="color-yellow" href="{{ path('modify_task_cw_p2', {"id": task.id}) }}"><i class="fas fa-cog"></i></a>
                                            {% endif %}

                                            {% if roles[userRole].task_p2_delete_button is defined and roles[userRole].task_p2_delete_button %}
                                                <a class="color-yellow" class="color-yellow" href="{{ path('delete_task_cw_p2', {"id": task.id}) }}" onclick="return confirm('Attention, vous vous apprêtez à supprimer une tâche P2')"><i class="fas fa-trash"></i></a>
                                            {% endif %}
                                            </div>
                                        </td>
                                    {% endif %}
                                {% endif %}

                                {% set showDoneButtonCw = roles[userRole].button_done is defined and roles[userRole].button_done %}
                                {% if showDoneButtonCw %}
                                    <td class="form-switch">
                                        {% if roles[userRole].button_done is defined and roles[userRole].button_done %}
                                        <input type="checkbox" id="taskdone" class="taskdone" {{ (task.done) ? 'checked' : '' }}
                                            data-taskdone="{{task.id}}">
                                        {% endif %}
                                    </td>
                                </tr>
                                {% endif %}
                            </tr>
                        {% endif %}
                    {% endfor %}
                </tbody>
            </table>

            {{ form_end(form_task_cw_p2_add) }}
        </div>

{%  endblock %}
{% block javascripts %}
	{{ parent() }}
	<script>
		$(()=>{
            const escapeHtml = (value) => $("<div>").text(value ?? "").html();
            const hasActions = {{ (userRole is not null and roles[userRole] is defined and (
                (roles[userRole].waiting_return_in_p2_cw is defined and roles[userRole].waiting_return_in_p2_cw) or
                (roles[userRole].task_p2_cw_to_p1_nw_button is defined and roles[userRole].task_p2_cw_to_p1_nw_button) or
                (roles[userRole].p1_button_in_p2_cw is defined and roles[userRole].p1_button_in_p2_cw) or
                (roles[userRole].task_p2_modify_button is defined and roles[userRole].task_p2_modify_button) or
                (roles[userRole].task_p2_delete_button is defined and roles[userRole].task_p2_delete_button)
            )) ? 'true' : 'false' }};
            const hasDone = {{ (userRole is not null and roles[userRole] is defined and roles[userRole].button_done is defined and roles[userRole].button_done) ? 'true' : 'false' }};
            const canWaitingReturn = {{ (userRole is not null and roles[userRole] is defined and roles[userRole].waiting_return_in_p2_cw is defined and roles[userRole].waiting_return_in_p2_cw) ? 'true' : 'false' }};
            const canToP1 = {{ (userRole is not null and roles[userRole] is defined and roles[userRole].task_p2_cw_to_p1_nw_button is defined and roles[userRole].task_p2_cw_to_p1_nw_button) ? 'true' : 'false' }};
            const canToNextWeek = {{ (userRole is not null and roles[userRole] is defined and roles[userRole].p1_button_in_p2_cw is defined and roles[userRole].p1_button_in_p2_cw) ? 'true' : 'false' }};
            const canModify = {{ (userRole is not null and roles[userRole] is defined and roles[userRole].task_p2_modify_button is defined and roles[userRole].task_p2_modify_button) ? 'true' : 'false' }};
            const canDelete = {{ (userRole is not null and roles[userRole] is defined and roles[userRole].task_p2_delete_button is defined and roles[userRole].task_p2_delete_button) ? 'true' : 'false' }};
            const urlWaitingReturn = "{{ path('to_p2_from_waiting_return_cw', {'id': 'TASK_ID'}) }}";
            const urlToP1 = "{{ path('change_task_cw_to_p1', {'id': 'TASK_ID'}) }}";
            const urlToNextWeek = "{{ path('change_task_p2_cw_to_p2_nw', {'id': 'TASK_ID'}) }}";
            const urlModify = "{{ path('modify_task_cw_p2', {'id': 'TASK_ID'}) }}";
            const urlDelete = "{{ path('delete_task_cw_p2', {'id': 'TASK_ID'}) }}";

			$(".js-inline-add-toggle").on("click", function (e) {
				e.preventDefault();
				const target = $(this).data("target");
				$(target).removeClass("d-none");
			});

			$(".js-inline-add-cancel").on("click", function () {
				const target = $(this).data("target");
				$(target).addClass("d-none");
			});

            $("#inlineAddTaskP2Form").on("submit", function (e) {
                e.preventDefault();

                const $form = $(this);
                const $errorRow = $("#inlineAddTaskP2Errors");
                const $errorBox = $errorRow.find(".message-error");

                $.ajax({
                    url: "{{ path('current_week_p2') }}",
                    method: "POST",
                    data: $form.serialize(),
                    dataType: "json",
                    headers: {
                        "X-Requested-With": "XMLHttpRequest"
                    }
                }).done((response) => {
                    if (!response.success) {
                        return;
                    }

                    const id = response.task.id;
                    const users = (response.task.users || []).map((u) => `${escapeHtml(u)}<br>`).join("");
                    const actionParts = [];
                    if (canWaitingReturn) {
                        actionParts.push(`<a class="color-yellow" href="${urlWaitingReturn.replace('TASK_ID', id)}"><i class="fas fa-hourglass-start"></i></a>`);
                    }
                    if (canToP1) {
                        actionParts.push(`<a class="color-yellow text-bold" href="${urlToP1.replace('TASK_ID', id)}"><span>P1</span></a>`);
                    }
                    if (canToNextWeek) {
                        actionParts.push(`<a class="color-yellow" href="${urlToNextWeek.replace('TASK_ID', id)}"><i class="fas fa-redo"></i></a>`);
                    }
                    if (canModify) {
                        actionParts.push(`<a class="color-yellow" href="${urlModify.replace('TASK_ID', id)}"><i class="fas fa-cog"></i></a>`);
                    }
                    if (canDelete) {
                        actionParts.push(`<a class="color-yellow" href="${urlDelete.replace('TASK_ID', id)}" onclick="return confirm('Attention, vous vous apprêtez à supprimer une tâche P2')"><i class="fas fa-trash"></i></a>`);
                    }

                    const actionHtml = hasActions ? `<td><div style="display:inline-flex;align-items:center;column-gap:8px;">${actionParts.join('')}</div></td>` : '';
                    const doneHtml = hasDone
                        ? `<td class="form-switch"><input type="checkbox" id="taskdone_${id}" class="taskdone" data-taskdone="${id}"></td>`
                        : '';

                    const rowHtml = `
                        <tr data-taskdone="${id}">
                            <td class="d-none">${id}</td>
                            <td class="color-white text-bold">${escapeHtml(response.task.customer)}</td>
                            <td class="color-white text-bold">${escapeHtml(response.task.subject)}</td>
                            <td class="color-white text-bold">${users}</td>
                            ${actionHtml}
                            ${doneHtml}
                        </tr>
                    `;

                    $("#inlineAddTaskP2Errors").after(rowHtml);
                    $errorBox.empty();
                    $errorRow.addClass("d-none");
                    $form.trigger("reset");
                    $("#inlineAddTaskP2Row").addClass("d-none");
                }).fail((xhr) => {
                    const errors = xhr.responseJSON && Array.isArray(xhr.responseJSON.errors)
                        ? xhr.responseJSON.errors
                        : ["Une erreur est survenue."];

                    $errorBox.html(errors.map((msg) => `<div>${escapeHtml(msg)}</div>`).join(""));
                    $errorRow.removeClass("d-none");
                    $("#inlineAddTaskP2Row").removeClass("d-none");
                });
            });

			$("#tableOrderTaskP1").on("reorder-row.bs.table", (e, table, row, old) => {
				$.ajax({
					url: "{{ path('reorder')}}",
					method: "POST",
					data: {
						table: JSON.stringify(table),
						context: 1
					},
					dataType: "JSON"
				})
			})
			$("#tableOrderTaskP2").on("reorder-row.bs.table", (e, table, row, old) => {
				$.ajax({
					url: "{{ path('reorder')}}",
					method: "POST",
					data: {
						table: JSON.stringify(table),
						context: 1
					},
					dataType: "JSON"
				})
			})
			$("#tableOrderAppointment").on("reorder-row.bs.table", (e, table, row, old) => {
				$.ajax({
					url: "{{ path('reorder')}}",
					method: "POST",
					data: {
						table: JSON.stringify(table),
						context: 2
					},
					dataType: "JSON"
				})
			})
			$("#tableOrderQuote").on("reorder-row.bs.table", (e, table, row, old) => {
				$.ajax({
					url: "{{ path('reorder')}}",
					method: "POST",
					data: {
						table: JSON.stringify(table),
						context: 3
					},
					dataType: "JSON"
				})
			})
		})
	</script>
{% endblock %}